# Apps Server
APPS_PORT=19089
# APPS_DB_PATH=./data/apps.db

# —— 大模型（OpenAI 兼容；LLM_* 与 OPENAI_* 等价，优先 LLM_*）——
OPENAI_API_KEY=sk-your-key
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 或使用：
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=

LLM_TIMEOUT_MS=60000

# Agent 消息推送回调（在 Agent 侧 POST /api/push/config 开启）
# callbackUrl 示例：http://127.0.0.1:19089/apps/hook
# APPS_HOOK_PATH=/apps/hook
