{
  "name": "frida-agent-example",
  "version": "1.2.0",
  "description": "Example Frida agent written in TypeScript",
  "private": true,
  "main": "agent/index.ts",
  "scripts": {
    "prepare": "npm run build",
    "build": "frida-compile agent/wx391027/index.ts -o agent/wx391027/index.js -c",
    "watch": "frida-compile agent/index.ts -o agent/_agent.js -w",
    "start": "frida -l dist/_agent.js WeChat.exe",
    "watch:http": "frida-compile agent/http.ts -o agent/http.js -w",
    "start:http": "frida -l agent/http.js WeChat.exe",
    "watch:lite": "frida-compile agent/xp-3.9.10.27.ts -o agent/xp-3.9.10.27.js -w",
    "start:lite": "frida -l agent/xp-3.9.10.27.js WeChat.exe",
    "build:lite": "frida-compile agent/xp-3.9.10.27.ts -o dist/xp-3.9.10.27.js -c",
    "watch:dev": "frida-compile agent/dev.ts -o agent/dev.js -w",
    "start:dev": "frida -l agent/dev.js WeChat.exe",
    "watch:wx391027": "frida-compile agent/wx391027/index.ts -o agent/wx391027/index.js -w",
    "start:wx391027": "frida -l agent/wx391027/index.js WeChat.exe",
    "watch:wx391027:test": "frida-compile agent/wx391027/test.ts -o agent/wx391027/test.js -w",
    "start:wx391027:test": "frida -l agent/wx391027/test.js WeChat.exe",
    "start:inject": "frida -l examples/inject.js WeChat.exe"
  },
  "devDependencies": {
    "@types/frida-gum": "^18.5.1",
    "@types/koa": "^2.15.0",
    "@types/koa-router": "^7.4.8",
    "@types/node": "^18.19.34",
    "frida-compile": "^16.4.1",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@frida/net": "^4.0.2",
    "frida": "^16.7.10",
    "http-parser-js": "^0.5.10",
    "koa": "^2.7.0",
    "koa-router": "^7.4.0",
    "sidecar": "^1.0.19",
    "ws": "^8.17.0"
  }
}
